<mujocoinclude>
    <worldbody>
        <body name="robot2" pos="0 0 0">
            <freejoint name="robot2_root"/>

            <!-- Robot 2 Third-Person Follow Camera -->
            <camera name="robot2_tpp_cam"
                    pos="-0.15 0 0.15"
                    xyaxes="0 -1 0  0.447 0 0.894"
                    fovy="60"/>

            <!-- Robot 2 Chassis: Violet/Purple (9.5cm x 9.5cm x 4.8cm) -->
            <!-- Top surface sits at z = 0.031 + 0.024 = 0.055m -->
            <geom name="robot2_chassis_geom"
                  type="box"
                  size="0.0475 0.0475 0.024"
                  pos="0 0 0.031"
                  rgba="0.75 0.75 0.8 1"/>

            <!-- ===================================================== -->
            <!-- ARUCO TRACKING PLATE (Marker ID 1)                    -->
            <!-- 8cm x 8cm plate mounted flush on top of the chassis   -->
            <!-- ===================================================== -->
            <!-- robot2.xml -->
            <geom name="robot2_aruco_plate"
                type="box"
                size="0.04 0.04 0.0005"
                pos="0 0 0.06"
                material="aruco1_mat"
                contype="0"
                conaffinity="0"/>

            <!-- ===================================================== -->
            <!-- LEFT WHEEL                                            -->
            <!-- ===================================================== -->
            <body name="robot2_left_wheel" pos="-0.02 0.0525 0.031">
                <joint name="robot2_left_wheel_joint"
                       type="hinge"
                       axis="0 1 0"
                       damping="0.005"/>
                <geom name="robot2_left_wheel_geom"
                      type="cylinder"
                      size="0.031 0.005"
                      rgba="0.2 0.2 0.2 1"
                      zaxis="0 1 0"
                      friction="2.0 0.005 0.0001"/>
            </body>

            <!-- ===================================================== -->
            <!-- RIGHT WHEEL                                           -->
            <!-- ===================================================== -->
            <body name="robot2_right_wheel" pos="-0.02 -0.0525 0.031">
                <joint name="robot2_right_wheel_joint"
                       type="hinge"
                       axis="0 1 0"
                       damping="0.005"/>
                <geom name="robot2_right_wheel_geom"
                      type="cylinder"
                      size="0.031 0.005"
                      rgba="0.2 0.2 0.2 1"
                      zaxis="0 1 0"
                      friction="2.0 0.005 0.0001"/>
            </body>

            <!-- ===================================================== -->
            <!-- CASTOR WHEEL                                          -->
            <!-- ===================================================== -->
            <body name="robot2_castor_wheel" pos="0.04 0 0.01">
                <joint name="robot2_castor_joint" type="ball"/>
                <geom name="robot2_castor_geom"
                      type="sphere"
                      size="0.01"
                      rgba="0.5 0.5 0.5 1"
                      friction="0.005 0.005 0.0001"/>
            </body>

            <!-- ===================================================== -->
            <!-- FRONT DIRECTION ARROW (Visual indicator)              -->
            <!-- Positioned low and forward to stay clear of the tag   -->
            <!-- ===================================================== -->
            <body name="robot2_direction_arrow" pos="0.035 0 0.058">
                <geom name="robot2_arrow_geom"
                      type="cylinder"
                      size="0.005 0.01"
                      rgba="0.8 1.0 0.1 1"
                      zaxis="1 0 0"
                      contype="0" conaffinity="0"/>
            </body>
        </body>
    </worldbody>

    <!-- Actuators -->
    <actuator>
        <motor name="robot2_left_motor"
               joint="robot2_left_wheel_joint"
               gear="1"/>
        <motor name="robot2_right_motor"
               joint="robot2_right_wheel_joint"
               gear="1"/>
    </actuator>
</mujocoinclude>