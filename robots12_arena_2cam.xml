<mujoco model="robots12_arena_2cam">
    <compiler angle="degree" coordinate="local"/>

    <option integrator="RK4"
            timestep="0.002"
            gravity="0 0 -9.81"/>

    <asset>
        <!-- Arena Floor Checker Texture -->
        <texture name="arena_floor_tex"
                 type="2d"
                 builtin="checker"
                 rgb1=".2 .3 .4"
                 rgb2=".1 .15 .2"
                 width="512"
                 height="512"
                 mark="cross"
                 markrgb=".8 .8 .8"/>

        <material name="arena_floor_mat"
                  texture="arena_floor_tex"
                  texrepeat="5 5"
                  texuniform="true"/>
        <!-- Clean Matte Arena Floor (Zero Specular Glare, No False-Quad Interference) -->
        <!-- <material name="arena_floor_mat"
                  rgba="0.75 0.77 0.80 1.0"
                  specular="0"
                  shininess="0"
                  reflectance="0"/> -->

        <material name="wall_mat" rgba="0.35 0.35 0.35 1"/>

        <!-- ========================================================= -->
        <!-- ARUCO ASSETS (Valid MJCF Schema, Zero Glare / Reflectance)-->
        <!-- ========================================================= -->
        
       
        <!-- ArUco Marker 0 -->
        <texture name="aruco0_tex" type="2d" file="aruco_0.png"/>
        <material name="aruco0_mat" 
                  texture="aruco0_tex" 
                  texuniform="false"
                  texrepeat="1 1"
                  specular="0" 
                  shininess="0" 
                  reflectance="0"/>

        <!-- ArUco Marker 1 -->
        <texture name="aruco1_tex" type="2d" file="aruco_1.png"/>
        <material name="aruco1_mat" 
                  texture="aruco1_tex" 
                  texuniform="false"
                  texrepeat="1 1"
                  specular="0" 
                  shininess="0" 
                  reflectance="0"/>
    </asset>

    <visual>
        <!-- Standard 16:9 offscreen buffer -->
        <global offwidth="1920" offheight="1080"/>
        <!-- offsamples="0" disables MSAA blur across high-contrast ArUco bits -->
        <quality shadowsize="2048" offsamples="0"/>
        <map znear="0.01"/>
    </visual>

    <worldbody>
        <!-- Lighting without hard localized glare -->
        <light name="arena_light"
               directional="false"
               diffuse=".85 .85 .85"
               specular=".1 .1 .1"
               pos="0 0 3.0"/>

        <!-- Ground Plane: 2m x 2m working area -->
        <geom name="arena_floor"
              type="plane"
              size="1 1 .25"
              material="arena_floor_mat"
              friction="2.0 0.005 0.0001"/>

        <!-- Boundary Walls (Height = 8cm, Thickness = 2cm) -->
        <geom name="wall_north" type="box" size="1.02 0.01 0.04" pos="0 1.01 0.04" material="wall_mat"/>
        <geom name="wall_south" type="box" size="1.02 0.01 0.04" pos="0 -1.01 0.04" material="wall_mat"/>
        <geom name="wall_east"  type="box" size="0.01 1.00 0.04" pos="1.01 0 0.04" material="wall_mat"/>
        <geom name="wall_west"  type="box" size="0.01 1.00 0.04" pos="-1.01 0 0.04" material="wall_mat"/>

        <!-- Target body placed at origin for automatic camera tracking -->
        <body name="arena_center" pos="0 0 0"/>

        <!-- ========================================================= -->
        <!-- NORTH & SOUTH SLANTED CAMERAS (720p Native 16:9 Setup)    -->
        <!-- ========================================================= -->
        <!-- <camera name="cam_south"
                pos="0 -1.15 1.45"
                mode="targetbody"
                target="arena_center"
                fovy="50"/>

        <camera name="cam_north"
                pos="0 1.15 1.45"
                mode="targetbody"
                target="arena_center"
                fovy="50"/> -->
        <!-- Height is 2.4 m -->
        <camera name="cam_south"
                pos="0 -1.15 2.1"
                mode="targetbody"
                target="arena_center"
                fovy="48"/>

        <camera name="cam_north"
                pos="0 1.15 2.1"
                mode="targetbody"
                target="arena_center"
                fovy="48"/>
    </worldbody>

    <!-- Robot Inclusions -->
    <include file="robot1.xml"/>
    <include file="robot2.xml"/>
</mujoco>